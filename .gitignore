# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# secrets and keys: never commit
*.key
*.p12
*.pfx
*.crt
credentials*.json
service-account*.json
/secrets/

# guest personal data: real guest lists, exports and DB dumps stay local
*.csv
!public/templates/*.csv
*.xlsx
*.xls
*.sql
!server/db/migrations/*.sql
*.dump
*.backup
/exports/
/data/

# typescript
*.tsbuildinfo
next-env.d.ts
