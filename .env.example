# Copy to .env.local and fill in (step by step: docs/SETUP.md). Never commit .env.local.
# Put each value right after the "=", with no spaces and no quotes.

# Neon connection string (Neon → Connect, with connection pooling on)
DATABASE_URL=

# http://localhost:3000 while developing; your real site address when deployed
APP_URL=

# Run: npm run secret. NEVER change it after invitations go out (BLUEPRINT D1)
TOKEN_SECRET=

# Run: npm run hash-password (asks for the password without showing it)
ADMIN_PASSWORD_HASH=

# The Gmail address that sends invitations
GMAIL_USER=

# The 16-letter Gmail app password, without spaces (needs 2-Step Verification)
GMAIL_APP_PASSWORD=

# Run: npm run secret (a different value from TOKEN_SECRET); protects /api/cron/*
CRON_SECRET=

# Optional. Which wedding the public pages show; defaults to our-wedding (the seeded one)
WEDDING_SLUG=
