# Copy to .env.local and fill in. Never commit .env.local.
DATABASE_URL=            # Neon connection string
APP_URL=                 # https://<project>.vercel.app
TOKEN_SECRET=            # long random string for jose
ADMIN_PASSWORD_HASH=     # output of: npx tsx scripts/hash-password.ts <password>
GMAIL_USER=              # sending Gmail address
GMAIL_APP_PASSWORD=      # Gmail app password (needs 2-Step Verification)
CRON_SECRET=             # protects /api/cron/* routes
